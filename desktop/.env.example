# Copy this file to %APPDATA%\GoodForm Gym\.env for the installed desktop app.
# For development, place a private .env file in the project root.

# SMTP account for encrypted database backup email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
BACKUP_EMAIL_FROM=goodform@example.com
BACKUP_EMAIL_TO=owner@example.com

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key separate from email and computer backups. Losing it prevents restore.
BACKUP_ENCRYPTION_KEY=
BACKUP_INITIAL_DELAY_MINUTES=5
BACKUP_INTERVAL_HOURS=24